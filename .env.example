# ---------------------------------------------------------------------------
# Lambda Page environment variables
# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.
# ---------------------------------------------------------------------------

# Postgres connection.
# LOCAL: a local Postgres running scripts/schema.sql.
# PRODUCTION (Vercel): the Supabase POOLER string — Supabase dashboard →
#   Connect → "Transaction pooler" (port 6543). Do NOT use the direct 5432
#   connection; serverless will exhaust it.
#   Shape: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/lambda_page

# The workspace (projects table row) that pages/tests hang off of.
# LOCAL value below; in the Supabase DB it is 111dff8e-bf1b-4864-874e-75d13ff7a3a0.
DEFAULT_PROJECT_ID=871185bc-bee1-4bf8-b70c-8f864943653b

# Absolute base URL of the deployment. Used to build the Pillar 2 tracking
# snippet install tag (its src + endpoint must be absolute since it runs on a
# customer's domain). Leave unset locally for same-origin testing.
# PRODUCTION: https://your-app.vercel.app  (or your custom domain)
# NEXT_PUBLIC_APP_URL=

# Optional: override the local Chromium path used for analysis in dev.
# LOCAL_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Required for the four Claude-powered tools: Message & Concept Testing
# (content/audience-fit), Competitive Scan (synthesis), Wireframe Testing,
# and Design & Content Audit. No fallback — these calls fail loudly with a
# clear error (surfaced on the run) if this is unset.
# ANTHROPIC_API_KEY=
